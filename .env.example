# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL: isi nilai sebenarnya hanya di .env milik Anda.
# Jangan commit .env atau membagikan connection string yang berisi password.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@YOUR_POOLER_HOST:5432/postgres"
# Ditulis terpisah agar simbol pada password otomatis diamankan untuk URI.
DATABASE_PASSWORD="YOUR_SUPABASE_DATABASE_PASSWORD"
DATABASE_SSL="true"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
# Opsional; default-nya server/prod-ca-2021.crt.
DATABASE_CA_CERT_PATH="server/prod-ca-2021.crt"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"

# Supabase Storage untuk semua foto portal. Secret hanya boleh berada di server.
# Buat bucket publik bernama portal-media dengan batas 500 KB dan MIME image/webp.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="portal-media"

# Dipakai satu kali oleh `npm run db:seed` sebagai password awal seluruh admin.
# Ganti melalui profil masing-masing admin setelah login pertama.
INITIAL_ADMIN_PASSWORD="CHANGE_ME_MINIMUM_12_CHARACTERS"

# Opsional: lokasi database.json lama untuk `npm run db:import-json`.
# Jika kosong, default-nya server/data/database.json.
# LEGACY_DATA_FILE="D:/path/private/database.json"
